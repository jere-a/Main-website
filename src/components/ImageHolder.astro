---
import { CldImage } from 'astro-cloudinary';
import '@/global.css';

interface Props {
	title: string;
  body?: string;
  cloudinary_id: string;
  width: number;
  height: number;
	alt?: string;
	transitionName?: string;
	/** Load eagerly and raise fetch priority. Use only for above-the-fold images. */
	priority?: boolean;
}

const { cloudinary_id, width, height, title, body, alt, transitionName, priority = false } = Astro.props;

const imageAlt = alt ?? title;
---

<div class={`card card${transitionName} gradient-border`}>
    { cloudinary_id &&
      <CldImage
        src={cloudinary_id}
        width={width}
        height={height}
        sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, (max-width: 1280px) 33vw, 25vw"
        class={`image`}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "low"}
        alt={imageAlt}
      />
    }

		<h2 class="title">{title}</h2>
		{body !== undefined && <p class="body">{body}</p>}
</div>

<style>
	.card {
		list-style: none;
		background-image: none;
    border-radius: 1rem;
    corner-shape: superellipse(0.6);
		backdrop-filter: blur(25px);
		.image {
			padding: 0.8rem;
      corner-shape: superellipse(0.6);
		}
	}

	h2 {
		padding: 5px;
		font-size: 1.25rem;
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
</style>
