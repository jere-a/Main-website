---
import { Font } from 'astro:assets';
import { getLangFromUrl } from '@/i18n/utils';
import NavMenu from '@/components/NavMenu.astro';
import Footer from '@/components/Footer.astro';
import { pwaInfo } from 'virtual:pwa-info';
import { siteConfig } from '@/config';

import type { Lang } from '@/i18n/types';

import '@/styles/view-transition.scss';
import '@/global.css';
import 'vanilla-cookieconsent/dist/cookieconsent.css';

interface Props {
  title?: string;
  lang?: Lang;
	isNavbar?: boolean;
	isFooter?: boolean;
  isDark?: boolean;
  isBanner?: boolean;
	isSplash?: boolean;
	isCopyright?: boolean;
	activeNav?: string;
}

const {
  title,
  lang = getLangFromUrl(Astro.url),
	isNavbar = true,
	isFooter = true,
  isDark = true,
  isBanner = true,
	activeNav,
} = Astro.props;

const titleFormat = title
  ? `${siteConfig.title} | ${title}`
  : siteConfig.title;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
const rssURL = new URL('rss.xml', Astro.site ?? siteConfig.url);
const humansURL = new URL('humans.txt', Astro.site ?? siteConfig.url);

const kaoid = 'kao';
---

<html class:list={[{ dark: isDark }]} lang={lang}>
  <head>
  	<meta charset="utf-8" />
  	<meta name="viewport" content="width=device-width" />
  	<title>{titleFormat}</title>
  	<meta name="generator" content={Astro.generator} />
  	<meta name="author" content={siteConfig.mainAuthor} />
  	<link rel="canonical" href={canonicalURL} />
  
  	<meta
  		name="description"
  		property="og:description"
  		content={siteConfig.description}
  	/>
  	<meta property="og:type" content="website" />
  	<meta property="og:url" content={canonicalURL} />
  	{siteConfig.siteName && (
  		<meta property="og:site_name" content={siteConfig.siteName} />
  	)}
  	<meta property="og:title" content={titleFormat} />
  	<meta property="og:image:alt" content={siteConfig.description} />
  
  	{siteConfig.siteName && (
  		<meta name="apple-mobile-web-app-title" content={siteConfig.siteName} />
  	)}
  	<meta
  		name="theme-color"
  		content="#310a65"
  		media="(prefers-color-scheme: light)"
  	/>
  	<meta
  		name="theme-color"
  		content="#20004A"
  		media="(prefers-color-scheme: dark)"
  	/>
  
  	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  	<link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
  	<link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
  
  	<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  	<link
  		rel="alternate"
  		type="application/rss+xml"
  		title="Åzze"
  		href={rssURL}
  	/>
  	<link rel="author" type="text/plain" href={humansURL} />

  	<link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
  	<link rel="dns-prefetch" href="https://t.ozze.eu.org" />
  
  	{pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  
  	<Font cssVariable="--font-creepster" />
  	<Font cssVariable="--font-butcherman" />
  	<slot name="head" />
  </head>
	<body>
		<header>
			{isBanner && <div id={kaoid} />}
      {isNavbar && <NavMenu active={activeNav} lang={lang} />}
		</header>
		<slot />
		{isFooter && <Footer />}
    {isBanner &&
      <script
        is:inline
        defer
        src="https://cdn.jsdelivr.net/gh/keepandroidopen/keepandroidopen.github.io@latest/public/banner.min.js"
        crossorigin="anonymous"
        blocking="render">
      </script>
    }
	</body>
</html>

<script>
  // oxlint-disable-next-line import/no-unassigned-import
  import "@/pwa";
  import "@/cookieconsent-config";
	import global from '@/lib/entry';
	global();
</script>
