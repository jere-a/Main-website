---
import { Font } from 'astro:assets';
import { getLangFromUrl } from '@/i18n/utils';
import NavMenu from '@/components/NavMenu.astro';
import Footer from '@/components/Footer.astro';
import { SEOMetadata } from 'astro-seo-metadata';
import { pwaInfo } from 'virtual:pwa-info';
import { siteConfig } from '@/config';

import type { Lang } from '@/i18n/types';

import '@/styles/view-transition.scss';
import '@/global.css';

interface Props {
  title?: string;
  lang?: Lang;
	isNavbar?: boolean;
	isFooter?: boolean;
  isDark?: boolean;
  isBanner?: boolean;
	isSplash?: boolean;
	isCopyright?: boolean;
	activeNav?: string;
}

const {
  title,
  lang = getLangFromUrl(Astro.url),
	isNavbar = true,
	isFooter = true,
  isDark = true,
  isBanner = true,
	activeNav,
} = Astro.props;

const kaoid = 'kao';
---

<html class:list={[{ dark: isDark }]} lang={lang}>
	<head>
    <SEOMetadata
	    siteName={siteConfig.siteName}
	    title={siteConfig.title + ' | ' + title}
	    description={siteConfig.description}
	    favicon={'/favicon.ico'}
	    author={siteConfig.mainAuthor}
	    copyright="ISC"
	    astroSitemap={true}
	    canonicalUrl={Astro.url.toString()}
	    type={'website'}
	    astroGenerator={true}
    />

    <meta charset="utf-8" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <meta name="theme-color" content="#310a65" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#20004A" media="(prefers-color-scheme: dark)" />
    <meta name="viewport" content="width=device-width" />
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <link rel="dns-prefetch" href="https://t.ozze.eu.org" />
    <link rel="alternate" type="application/rss+xml" title="Åzze" href={`${Astro.site}rss.xml`} />
    <link type="text/plain" rel="author" href={`${Astro.site}humans.txt`} />
    <link rel="expect" href="#the_unexpected" blocking="render" />

    <script src="/src/pwa.ts"></script>
    { pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} /> }

		<Font cssVariable="--font-creepster" />
		<Font cssVariable="--font-butcherman" />
		<slot name="head" />
	</head>
	<body>
		<header>
			{isBanner && <div id={kaoid} />}
      {isNavbar && <NavMenu active={activeNav} lang={lang} />}
		</header>
		<slot />
		{isFooter && <Footer />}
    {isBanner &&
      <script
        is:inline
        defer
        src="https://cdn.jsdelivr.net/gh/keepandroidopen/keepandroidopen.github.io@1668c3b644ec5a48d2098fced256a722b9b0ee6f/public/banner.js"
        integrity="sha256-IYcdTsLEgMZNoPR2N7KFPGuQHg2cj+6iEXVL8W7CXWM="
        crossorigin="anonymous"
        blocking="render">
      </script>
    }
	</body>
</html>

<script>
  // oxlint-disable-next-line import/no-unassigned-import
  import "@/cookieconsent-config.ts";
	import global from '@/lib/entry';
	global();
</script>
