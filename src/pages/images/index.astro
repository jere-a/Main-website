---
import Layout from '@/layouts/Layout.astro';
import ImageHolder from '@/components/ImageHolder.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = (await useTranslations(lang));

const images: {
  src: string;
  width: number;
  height: number;
	title: string;
}[] = [
	{
      src: "talvinen_maisema_2_om79rt",
      width: 2000,
      height: 1125,
		title: t.images.winterLandscape,
	},
	{
      src: "Iso_kanto_epmfrp",
      width: 2000,
      height: 1125,
		title: t.images.bigRoot,
	},
	{
      src: "sininen_taivas_lzk8uh",
      width: 2000,
      height: 1500,
		title: t.images.blueSky,
	},
	{
      src: "auringon_kukka_2_sluble",
      width: 1600,
      height: 1200,
		title: t.images.sunflower,
	},
	{
      src: "Aamuinen_usva_wuukjq",
      width: 4010,
      height: 3008,
		title: t.images.morningMist,
	},
	{
      src: "Isompi_silta_pimeällä_kkeoee",
      width: 1862,
      height: 1463,
		title: t.images.colorfulBridge,
	},
	{
      src: "silta_pimeällä_blhpkq",
      width: 2000,
      height: 1571,
		title: t.images.bridgeAtNight,
  },
  {
      src: "_MG_3181_hw2kj4",
      width: 5198,
      height: 3462,
    title: t.images.woodbird,
  },
  {
      src: "_MG_3060_p2jlcu",
      width: 5198,
      height: 3462,
    title: t.images.iris,
  },
  {
      src: "_MG_3119-hdr_ndpyap",
      width: 5198,
      height: 3462,
    title: t.images.lake,
  }
];
---

<Layout title={t.images.title} activeNav="kuvat">
	<h1 class="text-gradient title hero_text">{t.images.title}</h1>
	<p class="subtitle">{t.images.subtitle}</p>
	<ul role="list" class="image-card-grid cards">
		{
			images.map((image, i) => (
				<li>
          <ImageHolder cloudinary_id={image.src} width={image.width} height={image.height} title={image.title} transitionName={`${i}`} />
				</li>
			))
		}
	</ul>
</Layout>

<style>
	p.subtitle {
		margin-inline: auto;
		text-align: center;
		line-height: 1;
		margin-bottom: calc(var(--spacing) * 2);
		font-size: 1.2rem;
	}

	h1.title {
		line-height: 1;
		margin-bottom: calc(var(--spacing) * 4);
		font-size: 3.5rem;
		text-align: center;
		font-weight: 700;
	}

	.image-card-grid {
		--grid-min-col-size: 300px;

		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(var(--grid-min-col-size), 100%), 1fr));
		justify-items: center;
		gap: 0.5rem;
  }
</style>
